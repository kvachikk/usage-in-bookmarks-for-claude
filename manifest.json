{
  "manifest_version": 3,
  "name": "Claude Usage in Bookmarks",
  "version": "1.4.0",
  "description": "Shows your Claude.ai usage limits as a live-updating bookmark title on the bookmarks toolbar.",
  "homepage_url": "https://github.com/USERNAME/claude-usage-bookmark",

  "browser_specific_settings": {
    "gecko": {
      "id": "claude-usage-bookmark@local",
      "strict_min_version": "115.0"
    }
  },

  "permissions": ["bookmarks", "alarms", "storage"],
  "host_permissions": ["https://claude.ai/*"],

  "background": {
    "scripts": ["background.js"]
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "Claude usage — click to refresh now",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
